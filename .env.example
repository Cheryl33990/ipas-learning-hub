# .env.example: list of every environment variable this project reads.
# Copy to .env (`Copy-Item .env.example .env` / `cp .env.example .env`) and
# replace the <...> placeholders. Never commit .env; it is listed in .gitignore.
#
# Important: only Docker Compose reads .env automatically. The host-side Python
# commands (`uv run python -m ipas_hub.cli ...`) do NOT read .env; set the
# variables in section B in your shell instead (see docs/setup.md).
# Lines starting with "#" are optional; uncomment them only to change a default.

# ---------------------------------------------------------------------------
# A. Docker Compose (read automatically from .env by compose.yaml)
# ---------------------------------------------------------------------------

# Required for `--profile db`. Password of the `ipas` PostgreSQL user.
# No default: if empty, the db container refuses to start. Changing it later
# does not change the password of an already-initialised database.
PG_PASSWORD=<choose-a-strong-password>

# Optional. Host port for PostgreSQL, bound to 127.0.0.1. Default: 5433.
# PG_PORT=<port>

# Optional, `--profile llm`. Name of an EXISTING Docker volume that holds the
# Hugging Face model cache (vLLM loads it read-only, offline).
# Default: ipas-llm-models.
# LLM_MODEL_VOLUME=<docker-volume-name>

# Optional, `--profile llm`. Hugging Face model id and pinned revision served by vLLM.
# Defaults: Qwen/Qwen3-VL-8B-Instruct-FP8 at 9cdc6310a8cb770ce18efaf4e9935334512aee45.
# LLM_HF_MODEL=<org/model>
# LLM_HF_REVISION=<commit-sha>

# Optional. Model name vLLM exposes; also passed to the app container as LLM_MODEL.
# Default: qwen3-vl-8b-fp8. If you change it, use the same value for LLM_MODEL (section B).
# LLM_SERVED_NAME=<served-model-name>

# Optional, `--profile llm`. Fraction of GPU memory vLLM may use. Default: 0.62.
# LLM_GPU_UTIL=<0.0-1.0>

# Optional, `--profile ui` and `--profile serve`. Host port of the RAG endpoint.
# Default: 8100. The serve container publishes it on 127.0.0.1 only; the UI
# connects to it. If you run `ipas_hub.cli serve` on the host instead, keep
# its --port equal to this value.
# RAG_PORT=<port>
# RAG_SERVED_NAME=<route-name>

# Required for `--profile serve`. Host folder of your Hugging Face cache that
# already holds the embedding model (BAAI/bge-m3), mounted read-only; the
# container never downloads models. Usually <home>/.cache/huggingface, e.g.
# C:/Users/<you>/.cache/huggingface on Windows. Without it the endpoint cannot
# embed questions and fails at startup.
# HF_CACHE_DIR=<path>

# Optional, `--profile serve`. Route file mapping chat model names to knowledge
# bases, as a path inside the image. Default: config/rag-routes.json.
# RAG_ROUTES=<path>

# ---------------------------------------------------------------------------
# B. Host-side Python (`uv run python -m ipas_hub.cli ...`)
#    Not read from .env: set these in your shell, e.g. PowerShell
#    `$env:LLM_MODEL = '...'` or bash `export LLM_MODEL=...`.
# ---------------------------------------------------------------------------

# Required for `--store pg` and `index --to-pg`. libpq connection string WITHOUT the password.
# No default. With the Compose db: host=127.0.0.1 port=<PG_PORT> dbname=ipas user=ipas
# PG_DSN=host=<host> port=<port> dbname=<db> user=<user>

# Required together with PG_DSN. Read by libpq (psycopg), kept out of PG_DSN and run logs.
# Use the same value as PG_PASSWORD above.
# PGPASSWORD=<same-as-PG_PASSWORD>

# Required for `ask` and `serve` (or pass --model). Model name on the
# OpenAI-compatible endpoint. No default. With the Compose vLLM: qwen3-vl-8b-fp8.
# LLM_MODEL=<served-model-name>

# Optional (or pass --llm-url). OpenAI-compatible base URL.
# Default: http://127.0.0.1:8000/v1 (local vLLM).
# LLM_BASE_URL=<http://host:port/v1>

# Optional. Bearer token for the endpoint. Default: none (local vLLM needs no key).
# Never written to run logs.
# LLM_API_KEY=<api-key>

# Optional (or pass --allow-remote). Set to 1 to allow a non-local endpoint;
# remote endpoints must use https. Default: unset = only localhost/127.0.0.1/vllm.
# Remote services may charge you and will receive your questions and retrieved text.
# LLM_ALLOW_REMOTE=<1>

# ---------------------------------------------------------------------------
# C. Development and build (normally not set by hand)
# ---------------------------------------------------------------------------

# Optional. Enables the database tests in tests/test_pgstore.py; they are skipped
# when unset. Use a throwaway database: each test creates its own schema.
# CI sets it to its PostgreSQL service container.
# PG_TEST_DSN=host=<host> port=<port> dbname=<db> user=<user> password=<password>

# Fallback code version recorded in the index manifest when `git rev-parse HEAD`
# is unavailable (e.g. inside the runtime image, where the Docker build sets it from
# --build-arg CODE_VERSION=<commit>). Default: unavailable. No need to set it on the host.
# IPAS_CODE_VERSION=<commit-sha>
